# =============================================================================
# Validax Email Validation - Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholder values with your actual keys
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port number for the Node.js server (default: 3000)
PORT=3000

# Trust proxy when behind reverse proxy (nginx, cloudflare, etc.)
# Set to 1 only behind a trusted reverse proxy
TRUST_PROXY=0

# Force HSTS header (only enable when HTTPS is guaranteed)
FORCE_HSTS=0

# -----------------------------------------------------------------------------
# API Keys & Services
# -----------------------------------------------------------------------------

# emailvalidation.io API key for deep SMTP mailbox verification
# Get your free key at: https://emailvalidation.io/
# Free tier: 100 credits/month, 10 requests/minute
EMAIL_VALIDATION_API_KEY=replace_with_your_emailvalidation_io_key

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Global daily cap for deep mailbox checks across all IPs
# Set below your monthly quota to prevent overuse (default: 80)
# Recommended: 80 for 100/month free tier
DEEP_DAILY_CAP=80

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - Keep EMAIL_VALIDATION_API_KEY private (server-side only)
# - Local/DNS/reputation checks work without any API keys
# - Deep checks require EMAIL_VALIDATION_API_KEY
# =============================================================================
